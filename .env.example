NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Gunakan nilai acak minimal 32 karakter di production.
SESSION_SECRET=
SESSION_STORE=memory
SESSION_TTL_SECONDS=28800
# Durasi "Ingat saya" (default 30 hari, maksimum 90 hari).
SESSION_REMEMBER_TTL_SECONDS=2592000
# 64 karakter hex (32 byte) untuk enkripsi secret webhook.
APP_ENCRYPTION_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wa_service
DB_USER=wa_service_app
DB_PASSWORD=
DB_POOL_MIN=2
DB_POOL_MAX=10

# Dipakai tooling schema/validator/data-copy Supabase. Simpan URL asli di
# environment lokal/secret manager, jangan commit.
CUTOVER_TARGET_DATABASE_URL=
# Opsional: path absolut CA PEM bila kebijakan deployment memakai CA khusus.
CUTOVER_TARGET_SSL_CA_PATH=
# Hanya set true setelah maintenance mode aktif dan seluruh writer sudah berhenti.
CUTOVER_WRITES_FROZEN=false
# Guard kedua final copy. Isi COPY_TO_SUPABASE hanya pada maintenance window.
CUTOVER_COPY_CONFIRM=

DEFAULT_COUNTRY_CODE=62
BODY_LIMIT=2mb
UPLOAD_MAX_BYTES=10485760
TRUST_PROXY=false
PUPPETEER_NO_SANDBOX=false

# Recovery pesan yang masuk saat service offline. Startup memeriksa hingga 100
# pesan masuk per chat aktif dalam 72 jam terakhir; setelah ready dilakukan
# scan ringan berkala. Nilai dibatasi validator untuk menjaga beban Chromium.
WHATSAPP_RECOVERY_SYNC_INTERVAL_MS=30000
WHATSAPP_RECOVERY_MESSAGE_LIMIT=100
WHATSAPP_RECOVERY_LOOKBACK_HOURS=72

START_MESSAGE_WORKER=false
MESSAGE_WORKER_POLL_MS=2000
# Rentang jeda acak global antar-penerima Blast/Reblast. Minimum di bawah
# 65000 ditolak saat startup; maksimum harus lebih besar atau sama dengan minimum.
BROADCAST_RECIPIENT_INTERVAL_MS=65000
BROADCAST_RECIPIENT_INTERVAL_MAX_MS=120000
# Rentang waktu tunggu acak setelah pesan alumni diterima sebelum bot membalas.
# Minimum 65 detik; nilai maksimum default dua menit.
CAMPAIGN_AUTO_REPLY_DELAY_MS=65000
CAMPAIGN_AUTO_REPLY_DELAY_MAX_MS=120000
MESSAGE_WORKER_LOCK_TIMEOUT_MS=300000
MESSAGE_SEND_TIMEOUT_MS=90000

# Verifikasi registrasi nomor saat import. Worker memproses satu nomor per tick
# dan hanya berjalan ketika koneksi WhatsApp berstatus ready.
START_CONTACT_VERIFICATION_WORKER=true
CONTACT_VERIFICATION_POLL_MS=1500
CONTACT_VERIFICATION_LOCK_TIMEOUT_MS=300000
CONTACT_VERIFICATION_MAX_ATTEMPTS=3
CONTACT_VERIFICATION_CACHE_TTL_SECONDS=86400

# Hanya untuk command `npm run admin:create`; jangan commit nilai sebenarnya.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
