{
  "name": "service-wa",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "dev": "nodemon --config nodemon.json ./bin/www",
    "test": "node --test",
    "db:migrate": "knex --knexfile knexfile.js migrate:latest",
    "db:rollback": "knex --knexfile knexfile.js migrate:rollback",
    "db:seed": "knex --knexfile knexfile.js seed:run",
    "db:export": "node scripts/export-db.js",
    "migration:preflight": "node scripts/cutover-preflight.js",
    "migration:validate": "node scripts/cutover-validate.js",
    "supabase:schema:apply": "node scripts/supabase-apply-baseline.js",
    "supabase:data:dry-run": "node scripts/supabase-copy-data.js",
    "supabase:data:copy": "node scripts/supabase-copy-data.js --commit",
    "postgres:runtime:audit": "node scripts/postgres-runtime-audit.js",
    "campaign:reprocess-replies": "node scripts/reprocess-campaign-replies.js",
    "admin:create": "node scripts/create-admin.js",
    "audit:prod": "npm audit --omit=dev"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "csrf-sync": "^4.2.1",
    "debug": "~2.6.9",
    "dotenv": "^16.0.1",
    "ejs": "^3.1.10",
    "ejs-layout": "^1.0.15",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.6.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "http-errors": "^2.0.1",
    "knex": "^3.3.0",
    "multer": "^2.2.0",
    "mysql2": "^3.23.2",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "puppeteer": "^24.16.2",
    "socket.io": "^4.8.3",
    "whatsapp-web.js": "1.34.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
